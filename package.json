{
  "name": "pixel-editor",
  "productName": "Pixel Editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "desktop:dev": "npm run dev",
    "build:renderer": "vite build",
    "build:icon": "node scripts/generate-icon.cjs",
    "dist:win": "npm run check && npm test && npm run build:icon && npm run build:renderer && npm run security:check && electron-builder --win nsis portable --publish never && npm run checksums:win && npm run test:smoke:desktop",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "security:check": "node scripts/security-check.cjs",
    "checksums:win": "node scripts/checksums-win.cjs",
    "test": "vitest run",
    "test:e2e:desktop": "playwright test",
    "test:smoke:desktop": "playwright test --config=playwright.smoke.config.ts",
    "check:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test:watch": "vitest",
    "bench": "tsx scripts/bench.ts",
    "bench:render": "playwright test --config=playwright.bench.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^31.0.0",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.4",
    "tslib": "^2.8.1",
    "tsx": "^4.20.5",
    "typescript": "~5.6.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.pixelatelier.editor",
    "productName": "Pixel Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "verifyUpdateCodeSignature": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Pixel-Editor-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pixel Editor",
      "include": "electron/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "fufhfhfu",
      "repo": "Pixel-Editor"
    },
    "fileAssociations": [
      {
        "ext": "pxproj",
        "name": "Pixel Editor project",
        "description": "Pixel Editor project",
        "role": "Editor",
        "mimeType": "application/vnd.pixel-editor.project+json"
      }
    ],
    "portable": {
      "artifactName": "Pixel-Editor-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "js-yaml": "^4.1.0"
  }
}
